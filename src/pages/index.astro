---
import '../styles/global.css';
const modules = [
  ['01', 'A small start. Room to grow.', 'Start with Game and Ctx. Reach for entities, components and fixed-step systems when your game needs them.', 'ecs.html', 'Explore the ECS', 'cargo run --example ecs'],
  ['02', 'Pixels, polygons, possibility.', 'A wgpu-powered 2D and 3D renderer, with physics, audio and UI alongside it. Build from code, with your own asset tools.', '3d.html', 'See the rendering guide', 'cargo run --example 3d'],
  ['03', 'See what your code is doing.', 'Inspect components, step a running simulation, capture screenshots and measure performance. Connect external tools and agents through MCP.', 'agents.html', 'Meet the runtime tools', 'cargo run --example editor'],
  ['04', 'Keep the simulation running.', 'Fixed-tick, headless runs without a window or GPU. Rust first, with C and C++ bindings for native integrations.', 'headless.html', 'Run headless', 'cargo run --example headless'],
];

// "Hello, world" step by step: each line says in which step it appears.
const S = (t: string) => `<span class="syntax">${t}</span>`;
const Q = (t: string) => `<span class="string">${t}</span>`;
const code: [number, string][] = [
  [1, `${S('use')} ponko::*;`],
  [1, ''],
  [1, `${S('fn')} <span class="function">main</span>() {`],
  [1, `    Game::new(${Q('"My Game"')}, 800, 600)`],
  [7, `        .system(|ctx| {`],
  [7, `            ${S('let')} dt = ctx.dt();`],
  [7, `            ctx.world.query::&lt;&amp;${S('mut')} Transform2D&gt;().for_each(|t| t.rotation += dt);`],
  [7, `        })`],
  [1, `        .run(|ctx| {`],
  [2, `            ctx.clear(Color::hex(0x2A1916));`],
  [3, `            ${S('let')} sprite = ctx.load_texture(${Q('"crab.png"')});`],
  [3, `            ${S('let mut')} position = vec2(400.0, 300.0);`],
  [6, `            ctx.world.spawn_batch((0..1_000).map(|i| {`],
  [6, `                ${S('let')} at = vec2((i % 40) ${S('as')} f32 * 20.0, (i / 40) ${S('as')} f32 * 24.0);`],
  [6, `                (Transform2D::at(at), Sprite::new(sprite))`],
  [6, `            }));`],
  [1, ''],
  [1, `            ${S('move')} |ctx: &amp;${S('mut')} Ctx| {`],
  [4, `                ${S('if')} ctx.key_down(Key::Right) {`],
  [4, `                    position.x += 200.0 * ctx.dt();`],
  [4, `                }`],
  [5, `                ${S('if')} ctx.key_down(Key::Left) {`],
  [5, `                    position.x -= 200.0 * ctx.dt();`],
  [5, `                }`],
  [3, `                ctx.draw(&amp;sprite, position);`],
  [1, `            }`],
  [1, `        });`],
  [1, `}`],
];
const steps = [
  ['Window', '<code>Game::new</code> opens an 800 × 600 window and runs your setup once. The closure it returns runs every frame.'],
  ['Color', '<code>ctx.clear</code> sets the color every frame starts from.'],
  ['Sprite', '<code>load_texture</code> reads <code>assets/crab.png</code>; <code>ctx.draw</code> puts it on screen each frame.'],
  ['Input', 'The frame loop reads <kbd>→</kbd> and moves the crab 200 pixels a second, whatever the frame rate.'],
  ['Both ways', 'Add <kbd>←</kbd> and the crab walks back.'],
  ['Entities', 'A thousand crabs, each an entity with a <code>Transform2D</code> and a <code>Sprite</code>. The engine draws them for you.'],
  ['Systems', 'A system runs every frame over every entity that has a <code>Transform2D</code>: the whole crowd turns at once.'],
];
// A pixel crab for the preview.
const crab = ['..X.......X..', '.XX.......XX.', '.X..X...X..X.', '.XXXOXXXOXXX.', '..XXXXXXXXX..', 'XXXXXXXXXXXXX', 'X.XXXXXXXXX.X', '..X.X...X.X..'];
const crabRects = crab
  .flatMap((row, y) => [...row].map((c, x) => (c === '.' ? '' : `<rect x="${x}" y="${y}" width="1.02" height="1.02" fill="${c === 'O' ? '#15100e' : '#ff7a5c'}"/>`)))
  .join('');

const facts = [
  ['12000', '', 'units in one ECS pool, simulated every frame'],
  ['1', '', 'mesh and material for every unit, drawn instanced'],
  ['2.1', ' MB', 'download, compressed. No plugin, no install.'],
];
const ticker = ['RUST FIRST', '2D + 3D', 'C / C++ BINDINGS', 'HEADLESS READY', 'WEBASSEMBLY', 'MCP TOOLS', 'HOT RELOAD'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15100e" />
    <title>Ponko — games begin with code.</title>
    <meta name="description" content="A code-first Rust engine for 2D and 3D games. Integrated simulation tools, C and C++ bindings, and room to build your own thing." />
    <link rel="canonical" href="https://ponko.dev/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content="Ponko — games begin with code." />
    <meta property="og:description" content="A code-first Rust engine for 2D and 3D games. Open source. Built to be explored." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ponko.dev/" />
    <meta property="og:image" content="https://ponko.dev/play/tide/poster.webp" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="glow" aria-hidden="true"></div>
    <div class="tail-progress" aria-hidden="true"></div>
    <div class="shell">
      <header>
        <a class="brand" href="/" aria-label="Ponko home"><img class="brand-mark" src="/brand/ponko-face.svg" width="46" height="36" alt="" />ponko<span class="cursor" aria-hidden="true">_</span></a>
        <nav aria-label="Main navigation">
          <a href="#play">Play</a><a href="/guide/">Guide</a><a href="https://docs.rs/ponko/">API <span aria-hidden="true">↗</span></a><a href="https://github.com/ponkoengine/ponko">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="eyebrow boot" style="--i:0"><span class="dot pulse" aria-hidden="true"></span> OPEN SOURCE GAME ENGINE <span class="version">v0.0.1 / early days</span></div>
          <div class="hero-grid">
            <div class="hero-copy">
              <h1 id="hero-title"><span class="wipe" style="--i:1">Games begin</span><br /><span class="wipe" style="--i:2">with <em>code.</em><span class="block-cursor" aria-hidden="true">▌</span></span></h1>
              <p class="intro boot" style="--i:3">A code-first Rust engine for 2D and 3D games.<br class="desktop-break" /> A little less ceremony. A lot to make.</p>
              <div class="actions boot" style="--i:4"><a class="button" href="/guide/getting-started.html">Start building <span aria-hidden="true">↗</span></a><a class="text-link" href="#play">Play the demo <span aria-hidden="true">↓</span></a></div>
              <div class="install boot" style="--i:5"><code><span aria-hidden="true">$ </span><span id="cmd">cargo add ponko</span><span class="caret" aria-hidden="true"></span></code><button id="copy" type="button" aria-label="Copy cargo add ponko command">copy <span aria-hidden="true">⧉</span></button></div>
              <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
            </div>
            <div class="art-terminal crt boot" style="--i:2" role="img" aria-label="A small low-poly island floating in the air, slowly turning. Drag to turn it, click for a new one.">
              <div class="terminal-bar"><span>~/worlds/your-next-idea</span><span aria-hidden="true">drag · click</span></div>
              <canvas class="island" id="island" aria-hidden="true"></canvas>
            </div>
          </div>
          <div class="ticker" aria-label={ticker.join(', ')}>
            <div class="ticker-track" aria-hidden="true">{[0, 1].map(() => <div>{ticker.map((t) => <span>{t}</span>)}</div>)}</div>
          </div>
          <div class="tail" aria-hidden="true"></div>
        </section>

        <section id="play" class="section play" aria-labelledby="play-title">
          <div class="section-heading reveal"><span class="label">00 · play it now</span><h2 id="play-title">This runs on Ponko.<br />Right here, in your tab.</h2><p>Tide is a small 3D game built with the engine and compiled to WebAssembly. Raise towers, and thousands of units re-route around them in the same frame.</p></div>
          <div class="play-grid">
            <div class="demo-window crt reveal" id="demo">
              <div class="terminal-bar"><span>~/play/tide <span class="muted">· webassembly + webgpu</span></span><a href="/play/tide/" class="bar-link">full screen ↗</a></div>
              <div class="demo-stage">
                <img src="/play/tide/poster.webp" alt="Tide: a glowing grid board with towers, and streams of units flowing from four red gates toward a core" width="1200" height="750" loading="lazy" decoding="async" />
                <a class="run" id="run" href="/play/tide/">
                  <span class="run-prompt">$ ./tide<span class="caret" aria-hidden="true"></span></span>
                  <span class="run-button">▶ run in browser</span>
                  <span class="run-note">2.1 MB · needs WebGPU</span>
                </a>
              </div>
            </div>
            <div class="facts">
              {facts.map(([n, unit, text], i) => (
                <div class="fact reveal" style={`--i:${i}`}><b><span class="count" data-to={n}>{Number(n).toLocaleString('en-US')}</span>{unit}</b><span>{text}</span></div>
              ))}
              <div class="how reveal" style="--i:3">
                <span class="label">how to play</span>
                <p>Units march from the glowing gates to your core. Click or tap a cell to raise a tower: it zaps whatever comes close, and the flow field bends around it. Space, or the round button, overcharges every tower.</p>
              </div>
            </div>
          </div>
        </section>

        <section id="inside" class="section" aria-labelledby="inside-title">
          <div class="section-heading reveal"><span class="label">01 · under the hood</span><h2 id="inside-title">Bring an idea.<br />Keep your hands on the code.</h2><p>Integrated tools to get moving. Direct APIs to make it yours.</p></div>
          <div class="modules">{modules.map(([number, title, description, page, link, cmd], i) => <article class="reveal" style={`--i:${i % 2}`}><span class="module-number">{number}</span><div><h3>{title}</h3><p>{description}</p><a href={`/guide/${page}`}>{link} <span aria-hidden="true">↗</span></a><code class="module-cmd"><span aria-hidden="true">$ </span>{cmd}</code></div></article>)}</div>
        </section>
        <section class="section hello" aria-labelledby="start-title">
          <div class="section-heading reveal"><span class="label">02 · hello, world</span><h2 id="start-title">The first frame<br />is yours.</h2><p>One setup closure. One frame loop. Seven steps from an empty window to a thousand spinning crabs. <a class="text-link" href="/guide/getting-started.html">Follow the tutorial <span aria-hidden="true">↗</span></a></p></div>
          <div class="hello-demo reveal" id="hello" data-captions={JSON.stringify(steps.map((x) => x[1]))}>
            <div class="hello-grid">
              <div class="code-window crt" style={`--lines:${code.length}`}><div class="terminal-bar"><span>src/main.rs</span><span>cargo run</span></div><pre><code>{code.map(([step, line]) => <span class="ln" data-step={step} hidden={step > 1} set:html={line || ' '} />)}</code></pre></div>
              <div class="game-window">
                <div class="terminal-bar"><span>My Game</span><span>800 × 600 · ● ● ●</span></div>
                <div class="game-stage" data-step="1">
                  <span class="empty-note">an empty frame, 60 times a second</span>
                  <div class="crowd" aria-hidden="true" style={`--crab:url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 13 8' shape-rendering='crispEdges'>${crabRects.replaceAll('"', "'")}</svg>`)}")`}></div>
                  <svg class="crab" viewBox="0 0 13 8" aria-hidden="true" set:html={crabRects}></svg>
                  <span class="keys-pad" aria-hidden="true"><kbd class="key key-left">←</kbd><kbd class="key key-right">→</kbd></span>
                </div>
                <p class="step-caption" id="step-caption" set:html={steps[0][1]}></p>
              </div>
            </div>
          </div>
        </section>
        <section class="section project" aria-labelledby="project-title">
          <span class="label reveal">03 · built in the open</span>
          <div class="project-grid"><div class="reveal"><h2 id="project-title">Early days.<br />Open doors.</h2><p>Ponko is a young engine with an ambitious direction. Expect rough edges, check the current capabilities, and help shape what comes next.</p><p>Contribute where you’re comfortable: Rust, a small bug fix, a clearer example. You don’t need to take on every language or write a book to help.</p></div><div class="directory code-window reveal" style="--i:1"><div class="terminal-bar"><span>~/ponko</span><span class="muted">zsh</span></div><div class="ls"><p class="ls-cmd"><span aria-hidden="true">❯ </span>ls -la</p><a href="https://github.com/ponkoengine/ponko/blob/main/ROADMAP.md"><span class="perm" aria-hidden="true">drwxr-xr-x</span><span class="ls-name">what-is-next/</span><span class="ls-desc">Read the roadmap</span><span class="ls-arrow" aria-hidden="true">↗</span></a><a href="https://github.com/ponkoengine/ponko/blob/main/CONTRIBUTING.md"><span class="perm" aria-hidden="true">drwxr-xr-x</span><span class="ls-name">make-it-better/</span><span class="ls-desc">Find your first contribution</span><span class="ls-arrow" aria-hidden="true">↗</span></a><a href="https://github.com/ponkoengine/ponko/issues"><span class="perm" aria-hidden="true">-rw-r--r--</span><span class="ls-name">talk-to-us.md</span><span class="ls-desc">Issues & ideas</span><span class="ls-arrow" aria-hidden="true">↗</span></a><a href="https://github.com/ponkoengine/ponko"><span class="perm" aria-hidden="true">-rwxr-xr-x</span><span class="ls-name">source.rs</span><span class="ls-desc">Read the code</span><span class="ls-arrow" aria-hidden="true">↗</span></a><p class="ls-cmd ls-idle"><span aria-hidden="true">❯ </span><span class="cursor" aria-hidden="true">_</span></p></div></div></div>
        </section>
        <section class="closing reveal"><img class="closing-mark" src="/brand/ponko-face.svg" width="112" height="87" alt="" /><h2>Make something<br /><em>only you would make.</em></h2><a class="button" href="/guide/getting-started.html">Get started <span aria-hidden="true">↗</span></a></section>
      </main>
      <div class="tail" aria-hidden="true"></div>
      <footer>
        <div class="foot-brand"><a class="brand" href="/"><img class="brand-mark" src="/brand/ponko-face.svg" width="36" height="28" alt="" />ponko</a><p>A friendly game engine in Rust. A world starts somewhere.</p></div>
        <div class="foot-col"><h3>Learn</h3><a href="/guide/getting-started.html">Get started</a><a href="/guide/">Guide</a><a href="https://docs.rs/ponko/">API reference ↗</a></div>
        <div class="foot-col"><h3>Project</h3><a href="https://github.com/ponkoengine/ponko">GitHub ↗</a><a href="https://github.com/ponkoengine/ponko/blob/main/ROADMAP.md">Roadmap ↗</a><a href="https://github.com/ponkoengine/ponko-website">Site source ↗</a></div>
        <p class="signoff"><span aria-hidden="true">❯ </span>exit <span class="muted">— thanks for stopping by. the panda will keep the den warm.</span></p>
      </footer>
    </div>
    <script>
      import { island } from '../scripts/island';
      import { hello } from '../scripts/hello';
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.documentElement.classList.add('js');

      // The tail along the top fills as you scroll.
      const root = document.documentElement;
      const progress = () => root.style.setProperty('--p', String(Math.min(1, scrollY / Math.max(1, root.scrollHeight - innerHeight))));
      addEventListener('scroll', progress, { passive: true });
      progress();


      const islandEl = document.querySelector<HTMLCanvasElement>('#island');
      if (islandEl) island(islandEl, still);
      const helloEl = document.querySelector<HTMLElement>('#hello');
      if (helloEl) hello(helloEl, still);

      // Copy the install command.
      const button = document.querySelector<HTMLButtonElement>('#copy');
      const status = document.querySelector<HTMLElement>('#copy-status');
      button?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('cargo add ponko');
          if (status) status.textContent = 'Copied. Your terminal is next.';
          button.textContent = 'copied ✓';
        } catch {
          if (status) status.textContent = 'Select and copy the command above.';
        }
      });

      // Type the install command once the hero has come in.
      const cmd = document.querySelector<HTMLElement>('#cmd');
      if (cmd && !still) {
        const text = cmd.textContent ?? '';
        cmd.textContent = '';
        let n = 0;
        setTimeout(function type() {
          cmd.textContent = text.slice(0, ++n);
          if (n < text.length) setTimeout(type, 45 + Math.random() * 55);
        }, 900);
      }

      // Reveal sections as they scroll in; count the demo's numbers up.
      const countUp = (el: HTMLElement) => {
        const to = Number(el.dataset.to);
        const decimals = (el.dataset.to ?? '').split('.')[1]?.length ?? 0;
        const format = (v: number) => v.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
        if (still) return;
        const t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 1100);
          el.textContent = format(to * (1 - Math.pow(1 - k, 3)));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const seen = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('in');
          e.target.querySelectorAll<HTMLElement>('.count').forEach(countUp);
          seen.unobserve(e.target);
        }
      }, { threshold: 0.18, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach((el) => seen.observe(el));

      // A soft light that follows the pointer (desktop only).
      const glow = document.querySelector<HTMLElement>('.glow');
      if (glow && !still && matchMedia('(pointer: fine)').matches) {
        addEventListener('pointermove', (e) => {
          glow.style.setProperty('--x', e.clientX + 'px');
          glow.style.setProperty('--y', e.clientY + 'px');
          glow.classList.add('on');
        }, { passive: true });
      }

      // The demo: on a desktop it runs inline; on touch screens, full screen.
      const run = document.querySelector<HTMLAnchorElement>('#run');
      run?.addEventListener('click', (e) => {
        if (matchMedia('(pointer: coarse)').matches || innerWidth < 760) return;
        e.preventDefault();
        const stage = run.parentElement!;
        const frame = document.createElement('iframe');
        frame.src = '/play/tide/';
        frame.title = 'Tide, a game built with Ponko';
        frame.allow = 'fullscreen';
        stage.classList.add('running');
        stage.append(frame);
        frame.addEventListener('load', () => frame.focus());
      });
    </script>
  </body>
</html>
