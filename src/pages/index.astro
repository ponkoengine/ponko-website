---
import '../styles/global.css';
import { Code } from 'astro:components';
import { readFileSync } from 'node:fs';
const manifest = JSON.parse(readFileSync(new URL('../../../public/play/build-info.json', import.meta.url), 'utf8'));
const games = [
  { id: 'asteroids', title: 'Asteroids', kind: '2D', description: 'Thrust, turn, shoot. Break the rocks into smaller rocks. Three lives; the next wave starts when the screen is clear.', controls: [['← → / A D', 'Turn'], ['↑ / W', 'Thrust'], ['Space', 'Shoot'], ['R', 'Restart']], files: ['asteroids.rs', 'bin/asteroids.rs', 'runtime.rs'] },
  { id: 'breakout', title: 'Breakout', kind: '2D', description: 'Clear fifty bricks. Catch the ball with the paddle; where it lands changes the angle of the rebound.', controls: [['← → / A D', 'Move'], ['Space', 'Serve'], ['R', 'Restart']], files: ['breakout.rs', 'bin/breakout.rs', 'runtime.rs'] },
  { id: 'arena', title: 'Arena', kind: '3D', description: 'Survive the drones. Move between cover, keep shooting, and dash out of a crowd. Each cleared wave brings more enemies, up to 200.', controls: [['WASD / arrows', 'Move'], ['Mouse + click', 'Aim & fire'], ['Space', 'Auto-aim fire'], ['Shift', 'Dash'], ['R', 'Restart']], files: ['arena.rs', 'bin/arena.rs', 'runtime.rs'] },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ponko — playable examples</title><meta name="description" content="Play Asteroids, Breakout, and a 3D arena shooter built with Ponko. Read the Rust source alongside the game. Compiled to WebAssembly." />
  <meta name="theme-color" content="#151716" /><link rel="canonical" href="https://ponko.dev/" /><link rel="icon" href="/favicon.svg" />
  <meta property="og:title" content="Ponko — playable examples" /><meta property="og:description" content="Three playable Rust games. The code is right there." /><meta property="og:type" content="website" /><meta property="og:url" content="https://ponko.dev/" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="shell">
<header><a class="brand" href="/" aria-label="Ponko home"><span aria-hidden="true">p.</span> ponko</a><nav aria-label="Main navigation"><a class="current" href="#examples">Examples</a><a href="/guide/">Guide</a><a href="https://docs.rs/ponko/">API</a><a href="https://github.com/ponkoengine/ponko">GitHub ↗</a></nav></header>
<main id="main">
<section class="intro" aria-labelledby="title"><div><h1 id="title">Playable examples<span>.</span></h1><p>Built with Ponko. Run a game, then read the Rust that drives it.</p></div><div class="install"><code>cargo add ponko</code><button id="copy" type="button" aria-label="Copy cargo add ponko">Copy</button><span class="sr-only" id="copy-status" role="status"></span></div></section>
<section id="examples" aria-label="Playable game examples">
<div class="game-picker" role="tablist" aria-label="Choose a game">{games.map((g,i)=><button type="button" id={`tab-${g.id}`} role="tab" aria-controls={`example-${g.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-game={g.id}><span class="game-index">0{i+1}</span><span>{g.title}</span><span class="kind">{g.kind}</span></button>)}</div>
{games.map((g,i)=><article id={`example-${g.id}`} class="example" role="tabpanel" aria-labelledby={`tab-${g.id}`} hidden={i!==0} data-example={g.id}>
  <div class="example-heading"><div><h2>{g.title}</h2><p>{g.description}</p></div><div class="view-switch" role="group" aria-label={`${g.title} view`}><button type="button" data-view="code" aria-pressed="false">Code</button><button type="button" data-view="play" aria-pressed="false">Play</button><button type="button" data-view="split" aria-pressed="true">Split <span aria-hidden="true">◫</span></button></div></div>
  <div class="workspace" data-layout="split">
    <section class="source-pane" aria-label={`${g.title} Rust source`}><div class="pane-bar"><label class="sr-only" for={`file-${g.id}`}>Source file</label><select id={`file-${g.id}`} data-file>{g.files.map((f,j)=><option value={j}>{f.startsWith('bin/')?`renderer · ${f}`:f==='runtime.rs'?'shared · runtime.rs':`game · ${f}`}</option>)}</select><a href={`https://github.com/ponkoengine/ponko-website/tree/main/games/src/${g.files[0]}`} data-source-link target="_blank" rel="noreferrer">Source ↗</a></div><div class="code-scroll" tabindex="0" aria-label="Scrollable Rust source">{g.files.map((f,j)=><div data-code-file={j} hidden={j!==0}><Code code={readFileSync(new URL(`../../../games/src/${f}`,import.meta.url),'utf8')} lang="rust" theme="github-dark" /></div>)}</div><div class="pane-foot"><span>Rust</span><span>Same source used for this build</span></div></section>
    <section class="play-pane" aria-label={`${g.title} playable game`}><div class="pane-bar"><span><span class="live-dot" aria-hidden="true"></span> {g.kind} / WebAssembly</span><div><button type="button" data-stop hidden>Stop</button><button type="button" data-fullscreen aria-label={`Full screen ${g.title}`}>Expand ↗</button></div></div><div class="game-viewport" data-stage><div class="launch-screen"><img src={`/screens/${g.id}.png`} alt="" width="960" height="600" loading={i===0?'eager':'lazy'} /><div class="launch-content"><button type="button" class="launch" data-launch>Play {g.title} <span aria-hidden="true">▶</span></button><span>{(manifest.games[g.id].bytes/1024/1024).toFixed(1)} MB · loaded on click</span></div></div></div><div class="pane-foot"><span data-game-status role="status">Ready to launch</span><a href={`/play/${g.id}/`} target="_blank" rel="noreferrer">Open in a tab ↗</a></div></section>
  </div>
  <div class="controls" aria-label={`${g.title} controls`}>{g.controls.map(([keys,label])=><span><kbd>{keys}</kbd> {label}</span>)}<span class="touch-note">Touch controls included</span></div>
</article>)}
<div class="build-note"><p>All three games run in Ponko, compiled from Rust to WebAssembly. Click the game to give it keyboard focus. Switching games stops the previous one.</p><a href="/play/build-info.json">Build details ↗</a></div>
</section>
<section class="about"><div><h2>A Rust game engine.</h2><p>Ponko has a 2D and 3D renderer, an ECS, physics, audio, UI, and a headless runtime. Start with a game loop; use more of the engine when you need it.</p><a href="/guide/getting-started.html">Get started →</a></div><div class="resource-links"><a href="/guide/"><span>Guide</span><span>Setup, concepts, and examples ↗</span></a><a href="https://docs.rs/ponko/"><span>API reference</span><span>Rust types and methods ↗</span></a><a href="https://github.com/ponkoengine/ponko"><span>Engine source</span><span>Code, issues, and contributions ↗</span></a></div></section>
</main>
<footer><a class="brand" href="/">ponko</a><span>Open source · Rust / C / C++</span><a href="https://github.com/ponkoengine/ponko-website">Website source ↗</a></footer>
</div>
<script>import '../scripts/examples';</script>
</body></html>
