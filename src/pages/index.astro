---
import '../styles/global.css';

const features = [
  ['Entities and systems', 'An archetype ECS with parallel queries. Small games can start with plain variables in a closure and move to entities later.', 'ecs.html'],
  ['2D and 3D rendering', 'A wgpu renderer: sprites, tilemaps, text, PBR meshes, glTF, animation, shadows, terrain and your own WGSL materials.', '3d.html'],
  ['Physics, audio, UI', 'Rapier physics in 2D and 3D, audio, UI, input action maps, scenes, prefabs and save files.', 'physics.html'],
  ['Inspect a running game', 'A runtime inspector, traces and profiling. An MCP server lets tools and AI agents start, step and screenshot your game.', 'agents.html'],
  ['Headless runs', 'Run the simulation at a fixed tick with no window and no GPU. Useful for servers, tests and long batch runs.', 'headless.html'],
  ['C and C++', 'A C API and a C++17 wrapper, for native code that needs to drive the engine or be driven by it.', 'c-cpp.html'],
  ['The web', 'Build for the browser with WebGPU or WebGL2. The game further up this page is one of those builds.', 'web.html'],
  ['Reloading', 'Assets reload when the file changes on disk. Code hot patching is there too, if you turn it on.', 'hot-patching.html'],
];

// "Hello, world" step by step: each line says in which step it appears.
const S = (t: string) => `<span class="kw">${t}</span>`;
const Q = (t: string) => `<span class="str">${t}</span>`;
const code: [number, string][] = [
  [1, `${S('use')} ponko::prelude::*;`],
  [1, ''],
  [1, `${S('fn')} <span class="fn">main</span>() {`],
  [1, `    Game::new(${Q('"My Game"')}, 800, 600)`],
  [7, `        .system(|ctx| {`],
  [7, `            ${S('let')} dt = ctx.dt();`],
  [7, `            ctx.world.query::&lt;&amp;${S('mut')} Transform2D&gt;().for_each(|t| t.rotation += dt);`],
  [7, `        })`],
  [1, `        .run(|ctx| {`],
  [2, `            ctx.clear(Color::hex(0x2A1916));`],
  [3, `            ${S('let')} sprite = ctx.load_texture(${Q('"crab.png"')});`],
  [3, `            ${S('let mut')} position = vec2(400.0, 300.0);`],
  [6, `            ctx.world.spawn_batch((0..1_000).map(|i| {`],
  [6, `                ${S('let')} at = vec2((i % 40) ${S('as')} f32 * 20.0, (i / 40) ${S('as')} f32 * 24.0);`],
  [6, `                (Transform2D::at(at), Sprite::new(sprite))`],
  [6, `            }));`],
  [1, ''],
  [1, `            ${S('move')} |ctx: &amp;${S('mut')} Ctx| {`],
  [4, `                ${S('if')} ctx.key_down(Key::Right) {`],
  [4, `                    position.x += 200.0 * ctx.dt();`],
  [4, `                }`],
  [5, `                ${S('if')} ctx.key_down(Key::Left) {`],
  [5, `                    position.x -= 200.0 * ctx.dt();`],
  [5, `                }`],
  [3, `                ctx.draw(&amp;sprite, position);`],
  [1, `            }`],
  [1, `        });`],
  [1, `}`],
];
const steps = [
  ['A window', '<code>Game::new</code> opens an 800 × 600 window. The closure given to <code>run</code> is your setup: it runs once and returns the closure that runs every frame.'],
  ['A colour', '<code>ctx.clear</code> fills each frame with one colour before anything else is drawn.'],
  ['A sprite', '<code>load_texture</code> loads <code>assets/crab.png</code>, and <code>ctx.draw</code> draws it every frame.'],
  ['Input', 'Hold <kbd>→</kbd> and the crab moves right at 200 pixels per second. Multiplying by <code>ctx.dt()</code> keeps that speed the same at any frame rate.'],
  ['Both ways', 'The same again for <kbd>←</kbd>.'],
  ['Entities', '<code>spawn_batch</code> creates a thousand entities, each with a position and a sprite. The engine draws them all for you.'],
  ['A system', 'A system is a function that runs every frame. This one turns every entity that has a <code>Transform2D</code>.'],
];
const captions = steps.map(([title, text], i) => `<span class="step-n">${i + 1} / ${steps.length}</span><b>${title}.</b> ${text}`);

// A pixel crab for the preview.
const crab = ['..X.......X..', '.XX.......XX.', '.X..X...X..X.', '.XXXOXXXOXXX.', '..XXXXXXXXX..', 'XXXXXXXXXXXXX', 'X.XXXXXXXXX.X', '..X.X...X.X..'];
const crabRects = crab
  .flatMap((row, y) => [...row].map((c, x) => (c === '.' ? '' : `<rect x="${x}" y="${y}" width="1.02" height="1.02" fill="${c === 'O' ? '#15100e' : '#ff7a5c'}"/>`)))
  .join('');

const facts = [
  ['12,000', 'units on the board, each one updated every frame'],
  ['1', 'instanced mesh draws all of them'],
  ['2.1 MB', 'to download. Nothing to install.'],
];
const gh = 'https://github.com/ponkoengine/ponko';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfaf7" />
    <title>Ponko, a game engine for Rust</title>
    <meta name="description" content="Ponko is a free, open-source engine for 2D and 3D games, written in Rust. You write the game as ordinary code; the engine handles the window, drawing, input, audio and physics." />
    <link rel="canonical" href="https://ponko.dev/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content="Ponko, a game engine for Rust" />
    <meta property="og:description" content="A free, open-source engine for 2D and 3D games, written in Rust." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ponko.dev/" />
    <meta property="og:image" content="https://ponko.dev/play/tide/poster.webp" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-row">
        <a class="brand" href="/" aria-label="Ponko home"><img src="/brand/ponko-face.svg" width="36" height="28" alt="" />Ponko</a>
        <nav aria-label="Main">
          <a href="#play">Demo</a>
          <a href="/guide/">Guide</a>
          <a href="https://docs.rs/ponko/">API</a>
          <a href={gh}>GitHub</a>
        </nav>
        <a class="pill small" href="/guide/getting-started.html">Get started</a>
      </div>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title" class="dot">A game engine for Rust</h1>
          <p class="lede">Ponko is a free, open-source engine for 2D and 3D games. You write the game as ordinary Rust code, and the engine handles the window, drawing, input, audio and physics.</p>
          <div class="actions">
            <a class="pill" href="/guide/getting-started.html">Get started</a>
            <a class="pill ghost" href="#play">Play the demo</a>
          </div>
          <div class="install">
            <code><span class="prompt" aria-hidden="true">$</span> cargo add ponko</code>
            <button id="copy" type="button" aria-label="Copy the command cargo add ponko">Copy</button>
            <span id="copy-status" class="copy-status" role="status" aria-live="polite"></span>
          </div>
        </div>
        <figure class="hero-art">
          <canvas id="island" aria-label="A small floating island drawn in dots. Drag to turn it, click for a new one." role="img"></canvas>
          <figcaption>Drag to turn the island. Click for a new one.</figcaption>
        </figure>
      </section>

      <section id="play" class="section" aria-labelledby="play-title">
        <div class="wrap">
          <div class="row">
            <h2 id="play-title" class="dot">Try it in your browser</h2>
            <div class="body">
              <p>Tide is a small game made with Ponko and compiled to WebAssembly. Units walk from the gates to your core. Click a cell to put a tower there: it zaps anything that comes close, and every unit works out a new path around it. Space charges all the towers at once.</p>
            </div>
          </div>
          <div class="demo" id="demo">
            <div class="demo-stage">
              <img src="/play/tide/poster.webp" alt="Tide: a grid board with towers, and streams of units walking from four gates toward a core in the middle" width="1200" height="750" loading="lazy" decoding="async" />
              <a class="run" id="run" href="/play/tide/">
                <span class="pill">Play Tide</span>
                <span class="run-note">2.1 MB, needs a browser with WebGPU</span>
              </a>
            </div>
            <div class="demo-foot">
              <dl class="facts">
                {facts.map(([n, text]) => <div><dt>{n}</dt><dd>{text}</dd></div>)}
              </dl>
              <a class="arrow" href="/play/tide/">Open full screen</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section band" aria-labelledby="hello-title">
        <div class="wrap">
          <div class="row">
            <h2 id="hello-title" class="dot">Hello, world</h2>
            <div class="body">
              <p>This is a whole program. It opens a window, draws a sprite and moves it with the arrow keys. The last two steps add a thousand entities and one system that turns them all.</p>
              <p><a class="arrow" href="/guide/getting-started.html">Write it yourself in the tutorial</a></p>
            </div>
          </div>
          <div class="hello" id="hello" data-captions={JSON.stringify(captions)}>
            <div class="code" style={`--lines:${code.length}`}>
              <div class="code-bar"><span>src/main.rs</span></div>
              <pre><code>{code.map(([step, line]) => <span class="ln" data-step={step} hidden={step > 1} set:html={line || ' '} />)}</code></pre>
            </div>
            <div class="game">
              <div class="game-bar"><span>My Game</span><span class="lights" aria-hidden="true"><i></i><i></i><i></i></span></div>
              <div class="game-stage" data-step="1">
                <span class="empty-note">An empty window, 60 frames a second</span>
                <div class="crowd" aria-hidden="true" style={`--crab:url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 13 8' shape-rendering='crispEdges'>${crabRects.replaceAll('"', "'")}</svg>`)}")`}></div>
                <svg class="crab" viewBox="0 0 13 8" aria-hidden="true" set:html={crabRects}></svg>
                <span class="keys" aria-hidden="true"><kbd class="key key-left">←</kbd><kbd class="key key-right">→</kbd></span>
              </div>
              <p class="step-caption" id="step-caption" set:html={captions[0]}></p>
            </div>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="features-title">
        <div class="wrap">
          <div class="row">
            <h2 id="features-title" class="dot">What's in it</h2>
            <div class="body">
              <p>The parts most games need, in one crate. Cargo features turn off what you don't use.</p>
            </div>
          </div>
          <ul class="features">
            {features.map(([title, text, page]) => (
              <li><h3>{title}</h3><p>{text}</p><a class="arrow" href={`/guide/${page}`}>Read the guide</a></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section band" aria-labelledby="early-title">
        <div class="wrap">
          <div class="row">
            <h2 id="early-title" class="dot">It's early</h2>
            <div class="body">
              <p>Ponko is at version 0.0.1. It runs real games, but the API still changes between versions, some things are missing, and not many people use it yet. If you need a mature engine today, Bevy or Unity will serve you better. The guide <a class="inline" href="/guide/comparison.html">compares the three</a> feature by feature.</p>
              <p>If you'd like to help shape it, bug reports, small fixes and clearer examples are all welcome.</p>
              <ul class="links">
                <li><a href={`${gh}/blob/main/ROADMAP.md`}><span>Roadmap</span><span>What works and what's next</span></a></li>
                <li><a href={`${gh}/blob/main/CONTRIBUTING.md`}><span>Contributing</span><span>How to send a change</span></a></li>
                <li><a href={`${gh}/issues`}><span>Issues</span><span>Bugs, questions and ideas</span></a></li>
                <li><a href={gh}><span>Source</span><span>github.com/ponkoengine/ponko</span></a></li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-row">
        <div class="foot-brand">
          <a class="brand" href="/"><img src="/brand/ponko-face.svg" width="36" height="28" alt="" />Ponko</a>
          <p>Free and open source under MIT or Apache 2.0.</p>
        </div>
        <div class="foot-col"><h3>Learn</h3><a href="/guide/getting-started.html">Get started</a><a href="/guide/">Guide</a><a href="https://docs.rs/ponko/">API reference</a></div>
        <div class="foot-col"><h3>Project</h3><a href={gh}>GitHub</a><a href={`${gh}/blob/main/ROADMAP.md`}>Roadmap</a><a href="https://github.com/ponkoengine/ponko-website">Website source</a></div>
      </div>
    </footer>

    <script>
      import { island } from '../scripts/island';
      import { hello } from '../scripts/hello';
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const islandEl = document.querySelector<HTMLCanvasElement>('#island');
      if (islandEl) island(islandEl, still);
      const helloEl = document.querySelector<HTMLElement>('#hello');
      if (helloEl) hello(helloEl, still);

      // Copy the install command.
      const button = document.querySelector<HTMLButtonElement>('#copy');
      const status = document.querySelector<HTMLElement>('#copy-status');
      button?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('cargo add ponko');
          button.textContent = 'Copied';
          setTimeout(() => (button.textContent = 'Copy'), 1800);
        } catch {
          if (status) status.textContent = 'Couldn’t copy. Select the command instead.';
        }
      });

      // The demo: on a desktop it runs in the page; on touch screens, full screen.
      const run = document.querySelector<HTMLAnchorElement>('#run');
      run?.addEventListener('click', (e) => {
        if (matchMedia('(pointer: coarse)').matches || innerWidth < 760) return;
        e.preventDefault();
        const stage = run.parentElement!;
        const frame = document.createElement('iframe');
        frame.src = '/play/tide/';
        frame.title = 'Tide, a game made with Ponko';
        frame.allow = 'fullscreen';
        stage.classList.add('running');
        stage.append(frame);
        frame.addEventListener('load', () => frame.focus());
      });
    </script>
  </body>
</html>
