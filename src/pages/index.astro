---
import { Code } from 'astro:components';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Install from '../components/Install.astro';
import Games from '../components/Games.astro';
import DotArt from '../components/DotArt.astro';
import type { ArtOptions } from '../lib/dot-art';
import { site, release } from '../site';
import { ponkoNight, ponkoPaper } from '../lib/shiki-ponko.mjs';
import { formatDate, getPosts, postHref } from '../lib/blog';
import emberHop from '../assets/home/ember-hop.jpg';
import lights from '../assets/home/lights.jpg';
import shaders from '../assets/home/shaders.jpg';
import battle from '../assets/home/battle.jpg';
import flow from '../assets/home/flow.jpg';
import inspector from '../assets/home/inspector.jpg';
import largerAerial from '../assets/home/larger-game-aerial.jpg';
import largerLakeshore from '../assets/home/larger-game-lakeshore.jpg';
import largerStreet from '../assets/home/larger-game-street.jpg';
import largerNight from '../assets/home/larger-game-night.jpg';

const gh = site.github;

// Frames from a private 3D game that is being ported to Ponko. Say no more
// about it than these captions do.
const largerGame = [
  { image: largerAerial, alt: 'Houses with red roofs along dirt roads on a grassy slope, with a forest behind them, seen from the air in afternoon light' },
  { image: largerLakeshore, alt: 'Tall grass in the foreground, a small silver car parked on a dirt track by a lake, and a line of forest on the far shore under scattered clouds' },
  { image: largerStreet, alt: 'The plastered wall and green shutters of a house on the left, and a red shop with a striped awning across a yard, with trees behind' },
  { image: largerNight, alt: 'The same houses from the air at night, with lit windows and dark forest around them' },
];
const released = formatDate(new Date(release.date));
const posts = (await getPosts()).filter((p) => !p.data.draft).slice(0, 3);

// The whole first program, in both languages. The Rust one is the guide's
// first game; the C++ one is the same game from examples/cpp/guide.cpp.
const rust = `use ponko::prelude::*;

fn main() {
    Game::new("My Game", 800, 600).run(|ctx| {
        let crab = ctx.gfx.load_texture("crab.png");
        let mut pos = vec2(400.0, 300.0);

        move |ctx: &mut Ctx| {
            let dt = ctx.time.dt();
            if ctx.input.key_down(Key::Right) { pos.x += 200.0 * dt; }
            if ctx.input.key_down(Key::Left)  { pos.x -= 200.0 * dt; }
            if ctx.input.key_pressed(Key::Escape) { ctx.quit(); }
            ctx.gfx.draw(crab, pos);
        }
    });
}`;
const cpp = `#include "ponko.hpp"

int main() {
    ponko::texture crab{};
    ponko::vec2 pos{400, 300};
    ponko::game("My Game", 800, 600)
        .system([&](ponko::ctx& ctx) {
            if (ctx.key_down(PONKO_KEY_RIGHT)) pos.x += 200 * ctx.dt();
            if (ctx.key_down(PONKO_KEY_LEFT))  pos.x -= 200 * ctx.dt();
            if (ctx.key_pressed(PONKO_KEY_ESCAPE)) ctx.quit();
            ctx.draw(crab, pos);
        })
        .run([&](ponko::ctx& ctx) { crab = ctx.load_texture("crab.png"); });
}`;

// What comes with the crate, in pictures. Each level is the one the guide
// gives the feature (see the maturity page).
const tiles = [
  { name: '2D', level: 'proven', image: emberHop, href: '/guide/drawing.html', link: 'Drawing in 2D',
    alt: 'A platformer level drawn with tiles, sprites, lights and text',
    text: 'Sprites, sprite sheets, Tiled tilemaps, text, particles and a camera.' },
  { name: '3D', level: 'tested', image: lights, href: '/guide/3d.html', link: 'Meshes, materials and the sun',
    alt: 'A dark floor of small cubes lit by dozens of coloured point lights',
    text: 'PBR meshes, glTF, skeletal animation, shadows, clustered lights, terrain and water, on wgpu.' },
  { name: 'Your own shaders', level: 'tested', image: shaders, href: '/guide/3d.html', link: 'Custom materials',
    alt: 'A pond with waves, a field of grass blades and a checkered ball, each drawn by its own shader',
    text: 'A material is a WGSL file you can open and change. This water and this grass are two of them.' },
  { name: 'Many entities', level: 'proven', image: battle, href: '/guide/ecs.html', link: 'Entities, components, queries',
    alt: 'Two armies of ten thousand units each, red and blue, meeting in two long fronts between rocks and mud',
    text: 'An archetype ECS with queries that can run across all cores. Here two armies of 10,000 units fight.' },
  { name: 'Pathfinding', level: 'tested', image: flow, href: '/guide/pathfinding.html', link: 'Flow fields',
    alt: 'Twenty thousand agents streaming along shared paths around obstacles toward one goal',
    text: 'Flow fields move crowds with one field for everyone. Here 20,000 agents share one.' },
  { name: 'An inspector', level: 'tested', image: inspector, href: '/guide/inspector.html', link: 'The inspector',
    alt: 'A running game with a panel beside it listing entities, their components and the time each system takes',
    text: 'A panel in the running game: entities, components, the time each system takes, pause and single-step.' },
];
const more: [string, string, string, string][] = [
  ['Physics', 'proven in 2D, tested in 3D', 'Rapier bodies, joints, characters and vehicles.', '/guide/physics.html'],
  ['UI', 'proven', 'Retained widgets, layout, animation and screen-reader records.', '/guide/ui.html'],
  ['Sound', 'tested', 'Music, effects and 3D positioning.', '/guide/audio.html'],
  ['Multiplayer', 'tested', 'Lockstep, rollback, replication and dedicated servers.', '/guide/multiplayer.html'],
  ['Scenes and saves', 'proven', 'Scenes, prefabs, save slots and settings.', '/guide/storage.html'],
  ['Runs without a window', 'proven', 'The same game at a fixed tick, for tests and servers.', '/guide/headless.html'],
  ['The web', 'tested', 'WebGPU and WebGL2 builds from the same code.', '/guide/web.html'],
  ['C and C++', 'tested', 'A C API and a C++17 wrapper over the same engine.', '/guide/c-cpp.html'],
  ['Tools for coding agents', 'tested', 'An MCP server that starts, steps and inspects a game.', '/guide/agents.html'],
];

// Measured against Bevy 0.20.1. Every number is from the guide's benchmark
// page, which gives the method, the ranges and the commands to run it again.
// Why someone would pick Ponko. Every figure is from the guide: the
// scoreboard and "Build times and download sizes" in performance.md, and
// "Speed" in c-cpp.md.
const reasons = [
  {
    fig: '16 of 16 workloads ahead', title: 'Speed before you tune anything',
    text: 'Ahead of Bevy 0.20.1 on all sixteen workloads measured on an Apple M4 Max. 100,000 moving sprites take 1.10&nbsp;ms against 11.6&nbsp;ms.',
    link: 'The sixteen workloads', href: '/guide/performance.html#ponko-vs-bevy-the-scoreboard',
  },
  {
    fig: '45 s against 118 s', title: 'Short builds and small files',
    text: 'A small 2D game builds from clean in 45 seconds, and its Bevy port in 118. The release binary is 19.4&nbsp;MB against 82.4&nbsp;MB.',
    link: 'Build times and sizes', href: '/guide/performance.html#build-times-and-download-sizes',
  },
  {
    fig: 'one crate, one version', title: 'The pieces in the box',
    text: 'Physics, UI, navigation, multiplayer, saves, an editor and an inspector ship with the engine and are released together.',
    link: 'What is in the guide', href: '/learn/',
  },
  {
    fig: 'fn(&mut Ctx)', title: 'A game that is a plain function',
    text: 'Systems run in the order you write them, at a fixed rate, so two runs of the same build do the same thing.',
    link: 'Determinism', href: '/guide/determinism.html',
  },
  {
    fig: 'no window, no GPU', title: 'Tests without a window',
    text: '<code>run_headless</code> steps a game for tests and servers. The test suite plays the three reference games that way.',
    link: 'Headless runs', href: '/guide/headless.html',
  },
  {
    fig: 'Rust, C, C++', title: 'C and C++ as well as Rust',
    text: 'A C API and a header-only C++17 wrapper. A battle of a million units ticks in 19.97&nbsp;ms in C++, against 18.85&nbsp;ms in Rust.',
    link: 'C and C++', href: '/guide/c-cpp.html',
  },
];
const measured: { what: string; ponko: number; bevy: number; unit: string; digits: number }[] = [
  { what: 'Visit one million entities', ponko: 0.165, bevy: 0.39, unit: 'ms', digits: 3 },
  { what: 'Draw 100,000 moving sprites', ponko: 1.1, bevy: 11.6, unit: 'ms', digits: 2 },
  { what: 'Draw 100,000 moving 3D meshes with a sun shadow', ponko: 4.65, bevy: 15.9, unit: 'ms', digits: 2 },
  { what: 'Build a small game from nothing, debug', ponko: 45.2, bevy: 118, unit: 's', digits: 1 },
];
const shown = (n: number, digits: number) => (n >= 100 ? n.toFixed(0) : n >= 10 ? n.toFixed(1) : n.toFixed(digits));

// "Hello, world" step by step: each line says in which step it appears.
const S = (t: string) => `<span class="kw">${t}</span>`;
const Q = (t: string) => `<span class="str">${t}</span>`;
const code: [number, string][] = [
  [1, `${S('use')} ponko::prelude::*;`],
  [1, ''],
  [1, `${S('fn')} <span class="fn">main</span>() {`],
  [1, `    Game::new(${Q('"My Game"')}, 800, 600)`],
  [7, `        .system(|ctx| {`],
  [7, `            ${S('let')} dt = ctx.time.dt();`],
  [7, `            ctx.world.query::&lt;&amp;${S('mut')} d2::Transform&gt;().for_each(|t| t.rotation += dt);`],
  [7, `        })`],
  [1, `        .run(|ctx| {`],
  [2, `            ctx.gfx.clear(Color::hex(0x2A1916));`],
  [3, `            ${S('let')} sprite = ctx.gfx.load_texture(${Q('"crab.png"')});`],
  [3, `            ${S('let mut')} position = vec2(400.0, 300.0);`],
  [6, `            ctx.world.spawn_batch((0..1_000).map(|i| {`],
  [6, `                ${S('let')} at = vec2((i % 40) ${S('as')} f32 * 20.0, (i / 40) ${S('as')} f32 * 24.0);`],
  [6, `                (d2::Transform::at(at), Sprite::new(sprite))`],
  [6, `            }));`],
  [1, ''],
  [1, `            ${S('move')} |ctx: &amp;${S('mut')} Ctx| {`],
  [4, `                ${S('if')} ctx.input.key_down(Key::Right) {`],
  [4, `                    position.x += 200.0 * ctx.time.dt();`],
  [4, `                }`],
  [5, `                ${S('if')} ctx.input.key_down(Key::Left) {`],
  [5, `                    position.x -= 200.0 * ctx.time.dt();`],
  [5, `                }`],
  [3, `                ctx.gfx.draw(sprite, position);`],
  [1, `            }`],
  [1, `        });`],
  [1, `}`],
];
const steps = [
  ['A window', '<code>Game::new</code> opens an 800 × 600 window. The closure given to <code>run</code> is your setup: it runs once and returns the closure that runs every frame.'],
  ['A colour', '<code>ctx.gfx.clear</code> fills each frame with one colour before anything else is drawn.'],
  ['A sprite', '<code>load_texture</code> loads <code>assets/crab.png</code>, and <code>ctx.gfx.draw</code> draws it every frame.'],
  ['Input', 'Hold <kbd>→</kbd> and the crab moves right at 200 pixels per second. Multiplying by <code>ctx.time.dt()</code> keeps that speed the same at any frame rate.'],
  ['Both ways', 'The same again for <kbd>←</kbd>.'],
  ['Entities', '<code>spawn_batch</code> creates a thousand entities, each with a position and a sprite. The engine draws them all for you.'],
  ['A system', 'A system is a function that runs every frame. This one turns every entity that has a <code>d2::Transform</code>.'],
];
const captions = steps.map(([title, text], i) => `<span class="step-n">${i + 1} / ${steps.length}</span><b>${title}.</b> ${text}`);

// A pixel crab for the preview.
const crab = ['..X.......X..', '.XX.......XX.', '.X..X...X..X.', '.XXXOXXXOXXX.', '..XXXXXXXXX..', 'XXXXXXXXXXXXX', 'X.XXXXXXXXX.X', '..X.X...X.X..'];
const crabRects = crab
  .flatMap((row, y) => [...row].map((c, x) => (c === '.' ? '' : `<rect x="${x}" y="${y}" width="1.02" height="1.02" fill="${c === 'O' ? '#15100e' : '#ff7a5c'}"/>`)))
  .join('');
---
<Base
  title="Ponko: a Rust game engine you write as plain code"
  description="Ponko is a free, open-source Rust engine for 2D and 3D games that you write as plain code, with rendering, physics, UI, audio and networking in one crate."
  socialTitle="Ponko Engine"
  socialDescription="A free, open-source Rust engine for 2D and 3D games that you write as plain code."
>
    <main id="main">
      <section class="hero wrap" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">A Rust game engine you write as plain code<span class="stop">.</span></h1>
          <p class="lede">Ponko is a free, open-source engine for 2D and 3D games. Rendering, physics, UI, audio and networking come in one crate, and your game is ordinary Rust you can read from top to bottom.</p>
          <div class="actions">
            <a class="pill" href="/guide/getting-started.html">Get started</a>
            <a class="pill ghost" href="/examples/">Run the examples</a>
          </div>
          <Install />
          <p class="status">Version {release.version}, released {released}. For Windows, macOS, Linux and the web: <a href="#today">what has been tested where</a>.</p>
        </div>
        <div class="code hero-code" id="hero-code">
          <div class="code-bar">
            <div class="tabs" role="tablist" aria-label="Language">
              <button type="button" role="tab" id="tab-rust" aria-controls="code-rust" aria-selected="true">Rust</button>
              <button type="button" role="tab" id="tab-cpp" aria-controls="code-cpp" aria-selected="false" tabindex="-1">C++</button>
            </div>
            <span>the whole program</span>
          </div>
          <div class="panels">
            <div class="panel" id="code-rust" role="tabpanel" aria-labelledby="tab-rust"><Code code={rust} lang="rust" themes={{ light: ponkoPaper, dark: ponkoNight }} defaultColor="light-dark()" /></div>
            <div class="panel" id="code-cpp" role="tabpanel" aria-labelledby="tab-cpp" hidden><Code code={cpp} lang="cpp" themes={{ light: ponkoPaper, dark: ponkoNight }} defaultColor="light-dark()" /></div>
          </div>
          <p class="code-note">A window, a sprite, and the arrow keys to move it. <a class="arrow" href="/guide/getting-started.html">Build it</a></p>
        </div>
      </section>

      <section id="play" class="section" aria-labelledby="play-title">
        <div class="wrap">
          <div class="row">
            <h2 id="play-title">See it run.</h2>
            <div class="body">
              <p>Wildfire is a game made with Ponko and compiled to WebAssembly. Fire runs through a valley with the wind, and you keep it away from five villages.</p>
              <p class="aside">Everything on this page was made by the people who build Ponko. Nobody else has released a game made with it yet.</p>
            </div>
          </div>
          <div class="demo demo-split" id="demo">
            <div class="demo-stage">
              <img src="/play/wildfire/poster.webp" alt="Wildfire: a forested valley at night with a river through it, and a wide front of fire burning through the trees toward a village" width="1200" height="750" loading="lazy" decoding="async" />
              <a class="run" id="run" href="/play/wildfire/" target="_blank" rel="noopener">
                <span class="pill">Play Wildfire</span>
                <span class="run-note">Opens in a new tab. 3.8 MB, needs WebGPU</span>
              </a>
            </div>
            <dl class="boards">
              <div><dt><canvas class="board" data-text="16,384" role="img" aria-label="16,384"></canvas></dt><dd>cells of fuel, heat and wind, stepped twenty times a second</dd></div>
              <div><dt><canvas class="board" data-text="3.8 MB" role="img" aria-label="3.8 MB"></canvas></dt><dd>to download, and nothing to install. <a class="arrow" href={`${site.websiteSource}/tree/main/demo/wildfire`}>Its source</a></dd></div>
            </dl>
          </div>

          <h3 class="sub">Three complete games in the repository</h3>
          <Games />

          <h3 class="sub">A larger 3D game, in progress</h3>
          <ul class="shots">
            {largerGame.map((s) => (
              <li><Image src={s.image} alt={s.alt} widths={[640, 960, 1280]} sizes="(max-width: 700px) 100vw, 600px" loading="lazy" /></li>
            ))}
          </ul>
          <p class="games-note">A private 3D game that is being ported to Ponko. Frames from the port, 24 November 2026.</p>
        </div>
      </section>

      <section id="features" class="section" aria-labelledby="features-title">
        <div class="wrap">
          <div class="row">
            <h2 id="features-title">One crate, and what is in it.</h2>
            <div class="body">
              <p><code>cargo add ponko</code> brings all of this, and Cargo features switch off what a game leaves out. Each part carries a level: <a href="/guide/maturity.html">what the levels mean</a>.</p>
            </div>
          </div>
          <ul class="tiles">
            {tiles.map((t) => (
              <li>
                <a href={t.href}>
                  <Image src={t.image} alt={t.alt} widths={[480, 800]} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 400px" loading="lazy" />
                  <h3>{t.name}<span class="level">{t.level}</span></h3>
                  <p>{t.text}</p>
                  <span class="arrow">{t.link}</span>
                </a>
              </li>
            ))}
          </ul>
          <ul class="more">
            {more.map(([name, level, text, href]) => (
              <li><a href={href}><b>{name}</b><span class="level">{level}</span><span class="more-text">{text}</span></a></li>
            ))}
          </ul>
        </div>
      </section>

      <section id="measured" class="section" aria-labelledby="measured-title">
        <div class="wrap">
          <div class="row">
            <h2 id="measured-title">Measured, with the method.</h2>
            <div class="body">
              <p>Sixteen workloads, written for both engines and run on the same machine. Four of them are below; the guide has the rest and the commands to run them yourself.</p>
            </div>
          </div>
          <ul class="bench" aria-label="Time taken, shorter is faster">
            {measured.map((m) => (
              <li>
                <h3>{m.what}</h3>
                <div class="bar ours" style={`--w:${((m.ponko / m.bevy) * 100).toFixed(1)}%`}><span>Ponko</span><i aria-hidden="true"></i><b>{shown(m.ponko, m.digits)} {m.unit}</b></div>
                <div class="bar theirs" style="--w:100%"><span>Bevy 0.20.1</span><i aria-hidden="true"></i><b>{shown(m.bevy, m.digits)} {m.unit}</b></div>
              </li>
            ))}
          </ul>
          <p class="bench-key">Each bar is the time taken. Shorter is faster.</p>
          <div class="fine">
            <p>Apple M4 Max, Metal, release builds, the median of three runs, 22 to 26 November 2026. Each engine is set up the way a new project starts. With Bevy's pipelined rendering turned on, which Ponko does not have, the sprite row is 1.02 ms against 6.74 ms.</p>
            <p>These are specific workloads, not a ranking of the engines. <a class="arrow" href="/guide/performance.html">The full tables and the method</a></p>
          </div>
        </div>
      </section>

      <section id="fit" class="section" aria-labelledby="fit-title">
        <div class="wrap">
          <div class="row">
            <h2 id="fit-title">Is it for you?</h2>
            <div class="body">
              <p>Ponko is for programmers who would rather read a game's code than assemble it in an editor or out of plugins.</p>
            </div>
          </div>
          <div class="pick">
            <h3>Pick Ponko if you want</h3>
            <ul>
              {reasons.map((r) => (
                <li>
                  <b>{r.title}</b>
                  <i class="fig">{r.fig}</i>
                  <span set:html={r.text} />
                  <a class="arrow" href={r.href}>{r.link}</a>
                </li>
              ))}
            </ul>
          </div>
          <div class="fit">
            <div>
              <h3>Pick Bevy if</h3>
              <ul>
                <li>you want the largest Rust game-engine community, with plugins and tutorials for most things;</li>
                <li>you want the engine to schedule your systems in parallel by itself (Ponko's parallel systems are opt-in);</li>
                <li>you need observers, generic relationships or a render graph, which Ponko does not have.</li>
              </ul>
            </div>
            <div>
              <h3>Pick Godot if</h3>
              <ul>
                <li>you want a visual editor and a scene tree;</li>
                <li>you want to script in GDScript or C#;</li>
                <li>you want an engine that years of released games were made with.</li>
              </ul>
            </div>
          </div>
          <div class="not-yet">
            <h3>Ponko is the wrong choice today if</h3>
            <ul>
              <li><b>you need the API to stay put.</b> Ponko is 0.x: a release can break code written for the one before.</li>
              <li><b>you are shipping on consoles.</b> Consoles are not supported.</li>
              <li><b>you need released games and a large team behind the engine.</b> Ponko has two maintainers and no released games yet.</li>
            </ul>
            <p><a class="arrow" href="/guide/comparison.html">Ponko next to Bevy and Unity, in detail</a> <a class="arrow" href="/guide/from-bevy.html">Coming from Bevy</a></p>
          </div>
        </div>
      </section>

      <section id="hello" class="section" aria-labelledby="hello-title">
        <div class="wrap">
          <div class="row">
            <h2 id="hello-title">Your first game, a few lines at a time.</h2>
            <div class="body">
              <p>The program from the top of this page, grown in seven steps. The panel beside the code is a drawing of each step, not the engine running.</p>
              <p><a class="arrow" href="/guide/getting-started.html">Write it yourself in the guide</a></p>
            </div>
          </div>
          <div class="hello" id="hello-demo" role="group" aria-roledescription="walkthrough" aria-label="A first game in seven steps">
            <div class="code" style={`--lines:${code.length}`}>
              <div class="code-bar"><span>src/main.rs</span><span class="code-meter" aria-hidden="true"><i></i></span></div>
              <pre><code>{code.map(([step, line]) => <span class="ln" data-step={step} hidden={step > 1} set:html={line || ' '} />)}</code></pre>
            </div>
            <div class="game">
              <div class="game-bar"><span>My Game</span><span>800 × 600</span></div>
              <div class="game-stage" data-step="1">
                <span class="empty-note">An empty window</span>
                <div class="crowd" aria-hidden="true" style={`--crab:url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 13 8' shape-rendering='crispEdges'>${crabRects.replaceAll('"', "'")}</svg>`)}")`}></div>
                <svg class="crab" viewBox="0 0 13 8" aria-hidden="true" set:html={crabRects}></svg>
                <span class="keys" aria-hidden="true"><kbd class="key key-left">←</kbd><kbd class="key key-right">→</kbd></span>
              </div>
              <div class="step-caption" id="step-caption">
                {captions.map((text, i) => <p class:list={['step-text', { on: i === 0 }]} set:html={text} />)}
              </div>
              <div class="step-nav">
                <ol class="step-dots">
                  {steps.map(([title], i) => <li><button type="button" data-go={i + 1} aria-label={`Step ${i + 1}: ${title}`} aria-current={i === 0 ? 'step' : undefined}><span>{title}</span></button></li>)}
                </ol>
                <div class="step-buttons">
                  <button type="button" class="step-button" data-step-back aria-label="Previous step" disabled><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
                  <button type="button" class="step-button" data-step-play aria-label="Pause the steps" aria-pressed="false"><svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg><svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6L12.5 8z" /></svg></button>
                  <button type="button" class="step-button" data-step-next aria-label="Next step"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
                </div>
