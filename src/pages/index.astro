---
import '../styles/global.css';

const gh = 'https://github.com/ponkoengine/ponko';

// The story told on the way down. Each chapter has its own picture in dots.
const chapters = [
  {
    id: 'entities', scene: 'swarm', tag: 'Entities',
    title: 'Twelve thousand units. One loop.',
    body: 'Start with plain variables in a closure. When the game outgrows them, move to an archetype ECS and its queries spread across every core you have.',
    points: [['Systems are functions', 'Write one, add it, and it runs every frame.'], ['Parallel by default', 'Queries split their work across threads for you.']],
    link: ['Entities and systems', 'ecs.html'],
  },
  {
    id: 'rendering', scene: 'terrain', tag: 'Rendering',
    title: '2D and 3D, on one renderer.',
    body: 'Sprites, tilemaps and text sit beside PBR meshes, glTF, animation, shadows and terrain. When the game needs a look of its own, you write the material.',
    points: [['Built on wgpu', 'Vulkan, Metal, DirectX and WebGPU from the same code.'], ['Your own shaders', 'Materials are WGSL files you can open and change.']],
    link: ['Rendering in 3D', '3d.html'],
  },
  {
    id: 'physics', scene: 'stack', tag: 'Physics, audio, UI',
    title: 'Everything a game needs is already in the box.',
    body: 'Rapier physics in 2D and 3D, audio, UI, input action maps, scenes, prefabs and save files. One crate, and Cargo features switch off whatever you leave out.',
    points: [['No plugin hunt', 'The parts are made to work with each other.'], ['Pay for what you use', 'A 2D game does not carry the 3D renderer.']],
    link: ['Physics', 'physics.html'],
  },
  {
    id: 'inspect', scene: 'report', tag: 'Inspect',
    title: 'See inside the game while it runs.',
    body: 'A runtime inspector, traces and profiling come with the engine. Run the simulation headless at a fixed tick, with no window and no GPU, for servers, tests and long batch runs.',
    points: [['Made for agents too', 'An MCP server lets AI tools start, step and screenshot your game.'], ['Reload as you work', 'Assets update when the file changes on disk.']],
    link: ['Working with agents', 'agents.html'],
  },
  {
    id: 'ship', scene: 'globe', tag: 'Ship',
    title: 'Desktop, browser, or inside your C++.',
    body: 'Build for the web with WebGPU or WebGL2 and send people a link. Or drive the engine from native code through its C API and C++17 wrapper.',
    points: [['A link is a release', 'The game below is a 2.1 MB web build.'], ['Bring your own code', 'Call Ponko from C and C++, or call them from Ponko.']],
    link: ['Building for the web', 'web.html'],
  },
];

// The stops on the rail at the left of the page.
const stops = [
  ['top', 'Start'],
  ...chapters.map((c) => [c.id, c.tag]),
  ['play', 'Play'],
  ['hello', 'Code'],
  ['early', 'Status'],
  ['go', 'Go'],
];

// "Hello, world" step by step: each line says in which step it appears.
const S = (t: string) => `<span class="kw">${t}</span>`;
const Q = (t: string) => `<span class="str">${t}</span>`;
const code: [number, string][] = [
  [1, `${S('use')} ponko::prelude::*;`],
  [1, ''],
  [1, `${S('fn')} <span class="fn">main</span>() {`],
  [1, `    Game::new(${Q('"My Game"')}, 800, 600)`],
  [7, `        .system(|ctx| {`],
  [7, `            ${S('let')} dt = ctx.dt();`],
  [7, `            ctx.world.query::&lt;&amp;${S('mut')} Transform2D&gt;().for_each(|t| t.rotation += dt);`],
  [7, `        })`],
  [1, `        .run(|ctx| {`],
  [2, `            ctx.clear(Color::hex(0x2A1916));`],
  [3, `            ${S('let')} sprite = ctx.load_texture(${Q('"crab.png"')});`],
  [3, `            ${S('let mut')} position = vec2(400.0, 300.0);`],
  [6, `            ctx.world.spawn_batch((0..1_000).map(|i| {`],
  [6, `                ${S('let')} at = vec2((i % 40) ${S('as')} f32 * 20.0, (i / 40) ${S('as')} f32 * 24.0);`],
  [6, `                (Transform2D::at(at), Sprite::new(sprite))`],
  [6, `            }));`],
  [1, ''],
  [1, `            ${S('move')} |ctx: &amp;${S('mut')} Ctx| {`],
  [4, `                ${S('if')} ctx.key_down(Key::Right) {`],
  [4, `                    position.x += 200.0 * ctx.dt();`],
  [4, `                }`],
  [5, `                ${S('if')} ctx.key_down(Key::Left) {`],
  [5, `                    position.x -= 200.0 * ctx.dt();`],
  [5, `                }`],
  [3, `                ctx.draw(&amp;sprite, position);`],
  [1, `            }`],
  [1, `        });`],
  [1, `}`],
];
const steps = [
  ['A window', '<code>Game::new</code> opens an 800 × 600 window. The closure given to <code>run</code> is your setup: it runs once and returns the closure that runs every frame.'],
  ['A colour', '<code>ctx.clear</code> fills each frame with one colour before anything else is drawn.'],
  ['A sprite', '<code>load_texture</code> loads <code>assets/crab.png</code>, and <code>ctx.draw</code> draws it every frame.'],
  ['Input', 'Hold <kbd>→</kbd> and the crab moves right at 200 pixels per second. Multiplying by <code>ctx.dt()</code> keeps that speed the same at any frame rate.'],
  ['Both ways', 'The same again for <kbd>←</kbd>.'],
  ['Entities', '<code>spawn_batch</code> creates a thousand entities, each with a position and a sprite. The engine draws them all for you.'],
  ['A system', 'A system is a function that runs every frame. This one turns every entity that has a <code>Transform2D</code>.'],
];
const captions = steps.map(([title, text], i) => `<span class="step-n">${i + 1} / ${steps.length}</span><b>${title}.</b> ${text}`);

// A pixel crab for the preview.
const crab = ['..X.......X..', '.XX.......XX.', '.X..X...X..X.', '.XXXOXXXOXXX.', '..XXXXXXXXX..', 'XXXXXXXXXXXXX', 'X.XXXXXXXXX.X', '..X.X...X.X..'];
const crabRects = crab
  .flatMap((row, y) => [...row].map((c, x) => (c === '.' ? '' : `<rect x="${x}" y="${y}" width="1.02" height="1.02" fill="${c === 'O' ? '#15100e' : '#ff7a5c'}"/>`)))
  .join('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#120e0c" />
    <title>Ponko Engine</title>
    <meta name="description" content="Ponko is a free, open-source engine for 2D and 3D games, written in Rust. You write the game as ordinary code; the engine handles the window, drawing, input, audio and physics." />
    <link rel="canonical" href="https://ponko.dev/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta property="og:title" content="Ponko Engine" />
    <meta property="og:description" content="A free, open-source engine for 2D and 3D games, written in Rust." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ponko.dev/" />
    <meta property="og:image" content="https://ponko.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ponko's red panda logo drawn in dots, beside the line: You make the game. Ponko runs it." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ponko Engine" />
    <meta name="twitter:description" content="A free, open-source engine for 2D and 3D games, written in Rust." />
    <meta name="twitter:image" content="https://ponko.dev/og.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <canvas id="dots" class="dots" aria-hidden="true"></canvas>

    <header class="top">
      <div class="wrap top-row">
        <a class="brand" href="/" aria-label="Ponko home"><img src="/brand/ponko-face.svg" width="36" height="28" alt="" />Ponko</a>
        <nav aria-label="Main">
          <a href="#play">Demo</a>
          <a href="/guide/">Guide</a>
          <a href="https://docs.rs/ponko/">API</a>
          <a href={gh}>GitHub</a>
        </nav>
        <a class="pill small" href="/guide/getting-started.html">Get started</a>
      </div>
    </header>

    <nav class="rail" id="rail" aria-label="On this page">
      <span class="rail-fill" aria-hidden="true"></span>
      <img class="rail-rider" src="/brand/ponko-face.svg" width="26" height="20" alt="" />
      <ol>
        {stops.map(([id, label], i) => (
          <li style={`top:${(i / (stops.length - 1)) * 100}%`}><a href={`#${id}`}><i aria-hidden="true"></i><span>{label}</span></a></li>
        ))}
      </ol>
    </nav>

    <main id="main">
      <section class="hero wrap" id="top" data-scene="logo" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">You make the game.<br />Ponko runs it<span class="stop">.</span></h1>
          <p class="lede">A free, open-source engine for 2D and 3D games in Rust. Your game is ordinary code you can read from top to bottom. The window, the renderer, input, audio and physics are already there.</p>
          <div class="actions">
            <a class="pill" href="/guide/getting-started.html">Get started</a>
            <a class="pill ghost" href="#play">Play the demo</a>
          </div>
          <div class="install">
            <code><span class="prompt" aria-hidden="true">$</span> cargo add ponko</code>
            <button class="copy" type="button" aria-label="Copy the command cargo add ponko">Copy</button>
          </div>
        </div>
      </section>

      <div class="story">
        {chapters.map((c) => (
          <section class="chapter" id={c.id} data-scene={c.scene} aria-labelledby={`${c.id}-title`}>
            <div class="wrap">
              <div class="chapter-copy">
                <h2 id={`${c.id}-title`}>{c.title}</h2>
                <p class="chapter-body">{c.body}</p>
                <ul class="points">
                  {c.points.map(([name, text]) => <li><b>{name}</b><span>{text}</span></li>)}
                </ul>
                <a class="arrow" href={`/guide/${c.link[1]}`}>{c.link[0]}</a>
              </div>
            </div>
          </section>
        ))}
      </div>

      <section id="play" class="section" data-scene="drift" aria-labelledby="play-title">
        <div class="wrap">
          <div class="row">
            <h2 id="play-title">Don't take our word for it. Play it.</h2>
            <div class="body">
              <p>Tide is a small game made with Ponko and compiled to WebAssembly. Units walk from the gates to your core. Click a cell to put a tower there: it zaps anything that comes close, and every unit works out a new path around it. Space charges all the towers at once.</p>
            </div>
          </div>
          <div class="demo" id="demo">
            <div class="demo-stage">
              <img src="/play/tide/poster.webp" alt="Tide: a grid board with towers, and streams of units walking from four gates toward a core in the middle" width="1200" height="750" loading="lazy" decoding="async" />
              <a class="run" id="run" href="/play/tide/">
                <span class="pill">Play Tide</span>
                <span class="run-note">2.1 MB, needs a browser with WebGPU</span>
              </a>
            </div>
            <dl class="boards">
              <div><dt><canvas class="board" data-text="12,000" role="img" aria-label="12,000"></canvas></dt><dd>units on the board, each one updated every frame</dd></div>
              <div><dt><canvas class="board" data-text="1" role="img" aria-label="1"></canvas></dt><dd>instanced mesh draws all of them</dd></div>
              <div><dt><canvas class="board" data-text="2.1 MB" role="img" aria-label="2.1 MB"></canvas></dt><dd>to download, and nothing to install. <a class="arrow" href="/play/tide/">Open full screen</a></dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section id="hello" class="section pin" data-scene="drift" aria-labelledby="hello-title" style={`--steps:${steps.length}`}>
        <div class="wrap pin-stage">
          <div class="row">
            <h2 id="hello-title">A whole game fits on one screen.</h2>
            <div class="body">
              <p>This is a complete program. It opens a window, draws a sprite and moves it with the arrow keys. The last two steps add a thousand entities and one system that turns them all.</p>
              <p><a class="arrow" href="/guide/getting-started.html">Write it yourself in the tutorial</a></p>
            </div>
          </div>
          <div class="hello" id="hello-demo" data-captions={JSON.stringify(captions)}>
            <div class="code" style={`--lines:${code.length}`}>
              <div class="code-bar"><span>src/main.rs</span><span class="code-meter" aria-hidden="true"><i></i></span></div>
              <pre><code>{code.map(([step, line]) => <span class="ln" data-step={step} hidden={step > 1} set:html={line || ' '} />)}</code></pre>
            </div>
            <div class="game">
              <div class="game-bar"><span>My Game</span><span>800 × 600</span></div>
              <div class="game-stage" data-step="1">
                <span class="empty-note">An empty window, 60 frames a second</span>
                <div class="crowd" aria-hidden="true" style={`--crab:url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 13 8' shape-rendering='crispEdges'>${crabRects.replaceAll('"', "'")}</svg>`)}")`}></div>
                <svg class="crab" viewBox="0 0 13 8" aria-hidden="true" set:html={crabRects}></svg>
                <span class="keys" aria-hidden="true"><kbd class="key key-left">←</kbd><kbd class="key key-right">→</kbd></span>
              </div>
              <p class="step-caption" id="step-caption" set:html={captions[0]}></p>
              <div class="step-nav">
                <ol class="step-dots">
                  {steps.map(([title], i) => <li><button type="button" data-go={i + 1} aria-label={`Step ${i + 1}: ${title}`} aria-current={i === 0 ? 'step' : undefined}><span>{title}</span></button></li>)}
                </ol>
                <p class="cue" aria-hidden="true"><i class="wheel"></i><span>Scroll to write the next step</span></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="early" class="section" data-scene="drift" aria-labelledby="early-title">
        <div class="wrap">
          <div class="row">
            <h2 id="early-title">It's early. That's the good part.</h2>
            <div class="body">
              <p>Ponko is at version 0.0.1. It already runs real games, and the one further up this page is one of them. The API still changes between versions, so expect to update your code as it settles.</p>
              <p>Arrive now and you get a say in what it becomes. Bug reports, small fixes and clearer examples all change the engine.</p>
              <ul class="links">
                <li><a href={`${gh}/blob/main/ROADMAP.md`}><span>Roadmap</span><span>What works and what's next</span></a></li>
                <li><a href={`${gh}/blob/main/CONTRIBUTING.md`}><span>Contributing</span><span>How to send a change</span></a></li>
                <li><a href={`${gh}/issues`}><span>Issues</span><span>Bugs, questions and ideas</span></a></li>
                <li><a href={gh}><span>Source</span><span>github.com/ponkoengine/ponko</span></a></li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="finale" id="go" data-scene="finale" aria-labelledby="go-title">
        <div class="finale-copy">
          <h2 id="go-title">The game in your head is ready when you are.</h2>
          <div class="actions">
            <a class="pill" href="/guide/getting-started.html">Start your first game</a>
          </div>
          <div class="install">
            <code><span class="prompt" aria-hidden="true">$</span> cargo add ponko</code>
            <button class="copy" type="button" aria-label="Copy the command cargo add ponko">Copy</button>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-row">
        <div class="foot-brand">
          <a class="brand" href="/"><img src="/brand/ponko-face.svg" width="36" height="28" alt="" />Ponko</a>
          <p>Free and open source under MIT or Apache 2.0.</p>
        </div>
        <div class="foot-col"><h3>Learn</h3><a href="/guide/getting-started.html">Get started</a><a href="/guide/">Guide</a><a href="https://docs.rs/ponko/">API reference</a></div>
        <div class="foot-col"><h3>Project</h3><a href={gh}>GitHub</a><a href={`${gh}/blob/main/ROADMAP.md`}>Roadmap</a><a href="https://github.com/ponkoengine/ponko-website">Website source</a></div>
      </div>
    </footer>

    <script>
      import { dots } from '../scripts/dots';
      import { board } from '../scripts/board';
      import { hello } from '../scripts/hello';
      import { smoothScroll, addStops } from '../scripts/smooth';
      smoothScroll();
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // The rail: the panda rides down it as the page scrolls, and the stops
      // behind it stay lit. Chapter text fades in as it reaches the middle.
      const rail = document.querySelector<HTMLElement>('#rail');
      const stops = rail ? [...rail.querySelectorAll('li')] : [];
      const copies = [...document.querySelectorAll<HTMLElement>('.chapter-copy')];
      let lit = -1;
      const canvas = document.querySelector<HTMLCanvasElement>('#dots');
      if (canvas) {
        dots(canvas, still, ({ index, between, count }) => {
          rail?.style.setProperty('--at', String((index + Math.min(1, between)) / (count - 1)));
          const now = between > 0.5 ? index + 1 : index;
          if (now !== lit) {
            lit = now;
            stops.forEach((el, i) => {
              el.classList.toggle('past', i <= now);
              el.classList.toggle('here', i === now);
            });
            rail?.classList.toggle('on', now > 0);
          }
          // On wide screens the words fade in and drift as they pass the
          // middle. On phones they simply scroll, over their own backing.
          const wide = innerWidth > 900;
          for (const el of copies) {
            if (!wide) {
              el.style.opacity = '';
              el.style.transform = '';
              continue;
            }
            const b = el.getBoundingClientRect();
            const off = (b.top + b.height / 2) / innerHeight - 0.5;
            el.style.opacity = String(Math.max(0, Math.min(1, 1.5 - Math.abs(off) * 3.4)));
            if (!still) el.style.transform = `translateY(${off * 46}px)`;
          }
        });
      }
      document.querySelectorAll<HTMLCanvasElement>('.board').forEach((el) => board(el, still));
      const helloEl = document.querySelector<HTMLElement>('#hello-demo');
      const helloPin = document.querySelector<HTMLElement>('#hello');
      if (helloEl && helloPin) {
        // On wide screens with a mouse or trackpad the section holds still
        // while the wheel steps through the program, one step per flick.
        // Phones and tablets scroll past it normally. Keep this query in
        // step with the .pin rules in global.css.
        const pinned = matchMedia('(min-width: 901px) and (hover: hover) and (pointer: fine)');
        addStops(helloPin, Number(getComputedStyle(helloPin).getPropertyValue('--steps')) || 7, () => pinned.matches);
        hello(helloEl, still, helloPin, pinned);
      }

      // Copy the install command.
      document.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('cargo add ponko');
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select it to copy';
          }
          setTimeout(() => (button.textContent = 'Copy'), 1800);
        });
      });

      // The demo: on a desktop it runs in the page; on touch screens, full screen.
      const run = document.querySelector<HTMLAnchorElement>('#run');
      run?.addEventListener('click', (e) => {
        if (matchMedia('(pointer: coarse)').matches || innerWidth < 760) return;
        e.preventDefault();
        const stage = run.parentElement!;
        const frame = document.createElement('iframe');
        frame.src = '/play/tide/';
        frame.title = 'Tide, a game made with Ponko';
        frame.allow = 'fullscreen';
        stage.classList.add('running');
        stage.append(frame);
        frame.addEventListener('load', () => frame.focus());
      });
    </script>
  </body>
</html>
