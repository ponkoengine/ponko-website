---
// The dot lab: try shapes, palettes and seeds for a post's picture in dots,
// see them in a real post hero, and copy the line for the post's front
// matter. Everything happens in the page (src/scripts/dot-lab.ts); what's
// built here is the starting picture, so the page isn't empty before then.
import Base from '../layouts/Base.astro';
import DotArt from '../components/DotArt.astro';
import DotGlow from '../components/DotGlow.astro';
import type { ArtOptions } from '../lib/dot-art';
import { slugify } from '../lib/slug.mjs';

const start = { title: 'A post about something new', lede: 'One or two sentences about the post. This is the description from its front matter.' };
const art: ArtOptions = { shape: 'life', palette: 'acid' };
const id = slugify(start.title);
---
<Base
  title="Dot lab · Ponko blog"
  description="Pick the picture in dots for a Ponko blog post: try every shape, palette and seed, and copy the line for the post."
>
  <main id="main" class="post lab" data-lab data-title={start.title} data-lede={start.lede}>
    <header class="post-hero lab-hero">
      <DotGlow id={id} art={art} />
      <DotArt id={id} art={art} cols={72} rows={40} class="post-hero-art" />
      <div class="wrap post-hero-grid">
        <div class="post-head">
          <a class="back" href="/blog/">Blog</a>
          <p class="post-kicker"><span>Dot lab</span><span data-lab-chip>life · acid</span></p>
          <h1 data-lab-title>{start.title}</h1>
          <p class="post-lede" data-lab-lede>{start.lede}</p>
        </div>
      </div>
    </header>

    <section class="wrap lab-panel" aria-label="The picture's settings">
      <div class="lab-col">
        <div class="lab-head">
          <h2 id="lab-shape-label">Shape</h2>
          <button type="button" class="pill small ghost" data-lab-surprise>Surprise me</button>
        </div>
        <div class="lab-shapes" role="group" aria-labelledby="lab-shape-label" data-lab-shapes></div>
      </div>

      <div class="lab-col">
        <h2 id="lab-palette-label">Palette</h2>
        <div class="lab-palettes" role="group" aria-labelledby="lab-palette-label" data-lab-palettes></div>

        <h2>Seed</h2>
        <p class="lab-hint">Any word. The same shape and palette, drawn differently. Leave it empty and the post's address is the seed.</p>
        <div class="lab-row">
          <input class="lab-input" type="text" spellcheck="false" autocomplete="off" placeholder="the post's address" aria-label="Seed" data-lab-seed />
          <button type="button" class="pill small ghost" data-lab-shuffle>Shuffle</button>
        </div>

        <h2>The post</h2>
        <label class="lab-label">Title
          <input class="lab-input" type="text" data-lab-title-input />
        </label>
        <label class="lab-label">Description
          <textarea class="lab-input" rows="2" data-lab-lede-input></textarea>
        </label>
        <p class="lab-hint">Address: <code data-lab-address></code></p>

        <h2>For the post's front matter</h2>
        <div class="lab-out">
          <pre><code data-lab-out></code></pre>
          <button type="button" class="pill small" data-lab-copy>Copy</button>
        </div>
        <p class="lab-hint">See <a href="https://github.com/ponkoengine/ponko-website/blob/main/WRITING.md">WRITING.md</a> for the rest of a post.</p>
      </div>
    </section>
  </main>
</Base>

<script>
  import { dotLab } from '../scripts/dot-lab';
  const root = document.querySelector<HTMLElement>('[data-lab]');
  if (root) dotLab(root);
</script>

<style is:global>
  .lab .post-hero-grid {
    padding-bottom: 104px;
  }
  .lab-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 48px;
    padding-bottom: 120px;
  }
  .lab-panel h2 {
    margin: 0 0 14px;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .lab-col > h2:not(:first-child) {
    margin-top: 36px;
  }
  .lab-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .lab-head h2 {
    margin: 0;
  }
  .lab-shapes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .lab-shape,
  .lab-palette {
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.2s, transform 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .lab-shape:hover,
  .lab-palette:hover {
    border-color: #4a3a32;
  }
  .lab-shape:active,
  .lab-palette:active {
    transform: scale(0.97);
  }
  .lab-shape[aria-pressed='true'],
  .lab-palette[aria-pressed='true'] {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgb(240 103 47 / 0.16);
    color: var(--ink);
  }
  .lab-shape:focus-visible,
  .lab-palette:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .lab-thumb {
    position: relative;
    display: block;
    aspect-ratio: 8 / 5;
    background: var(--night);
  }
  .lab-thumb .dot-art {
    position: absolute;
    inset: 0;
  }
  .lab-name {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    padding: 9px 12px;
    font-size: 14.5px;
  }
  .lab-name small {
    color: var(--muted);
    font-size: 12.5px;
  }
  .lab-palettes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(124px, 1fr));
    gap: 8px;
  }
  .lab-palette {
    display: grid;
    gap: 8px;
    padding: 10px 12px;
    font-size: 14px;
  }
  .lab-swatch {
    display: flex;
    gap: 4px;
  }
  .lab-swatch i {
    width: 20px;
    height: 20px;
    border-radius: 50%;
  }
  .lab-swatch .lab-auto {
    display: grid;
    place-items: center;
    width: auto;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--raised);
    color: var(--muted);
    font-size: 12px;
    font-style: normal;
  }
  .lab-hint {
    margin: -6px 0 12px;
    color: var(--muted);
    font-size: 14.5px;
  }
  .lab-hint a {
    color: var(--accent);
  }
  .lab-hint code {
    color: var(--text);
    font-size: 13.5px;
  }
  .lab-row {
    display: flex;
    gap: 8px;
  }
  .lab-label {
    display: grid;
    gap: 6px;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 14.5px;
  }
  .lab-input {
    width: 100%;
    min-height: 40px;
    padding: 9px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    color: var(--ink);
    font: inherit;
    font-size: 15.5px;
    resize: vertical;
  }
  .lab-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .lab-out {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding: 8px 8px 8px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
  }
  .lab-out pre {
    flex: 1;
    margin: 0;
    overflow-x: auto;
    color: var(--ink);
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .lab-panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .lab-panel .lab-col + .lab-col > h2:first-child {
      margin-top: 36px;
    }
    .lab-shapes {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 8px;
    }
    .lab-name {
      padding: 7px 9px;
      font-size: 13px;
    }
    .lab-name small {
      display: none;
    }
  }
</style>
