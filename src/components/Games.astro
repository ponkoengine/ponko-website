---
// The three reference games in the engine repository, each with a short
// clip recorded from the game. A clip plays once when it comes into view,
// and again when it is pointed at or tapped; asking for reduced motion
// leaves it a picture until it is tapped.
// A clip that is replaced gets a new file name: browsers keep the old file
// for hours under the old one.
import { getImage } from 'astro:assets';
import { site } from '../site';
import examples from '../data/gallery.json';
import coinDash from '../assets/home/coin-dash.jpg';
import emberHop from '../assets/home/ember-hop.jpg';
import shardGrove from '../assets/home/shard-grove.jpg';

const src = (path: string) => `${site.github}/tree/main/${path}`;
// The game's page in the web gallery, if the gallery has it.
const play = (example: string): [string, string][] =>
  examples.some((e) => e.example === example) ? [['Play in the browser', `${site.gallery}${example}/`]] : [];
const games = [
  {
    name: 'Coin Dash', image: coinDash, clip: '/media/coin-dash.mp4', width: 800, height: 600,
    alt: 'Coin Dash: a small knight on a grass field with four coins left to collect and a clock running',
    text: 'A small complete 2D game: menus, settings, rebindable controls and a saved best time, in English and Arabic.',
    links: [...play('coin_dash'), ['Read the source', src('examples/coin_dash')], ['How it is packaged', '/guide/packaging.html']],
  },
  {
    name: 'Ember Hop', image: emberHop, clip: '/media/ember-hop.mp4', width: 960, height: 540,
    alt: 'Ember Hop: a glowing ember spirit on a cave platform, with sparks to collect, spikes in a pit and a lit brazier',
    text: 'A platformer with two caves made in the Tiled map editor, physics, particles, sound and save slots.',
    links: [...play('ember_hop'), ['Read the source', src('examples/ember_hop')], ['How it was built', '/guide/ember-hop.html']],
  },
  {
    name: 'Shard Grove', image: shardGrove, clip: '/media/shard-grove-2.mp4', width: 960, height: 540,
    alt: 'Shard Grove: a hooded warden walking across a walled grove past a stone block, with a red crawler by the gate and a shard on a raised platform',
    text: 'A third-person 3D game: an animated character, enemies that patrol and chase on a navigation mesh, shadows and saves.',
    links: [...play('shard_grove'), ['Read the source', src('examples/shard_grove')], ['How it was built', '/guide/shard-grove.html']],
  },
];
const posters = await Promise.all(games.map((g) => getImage({ src: g.image, width: 960, format: 'webp' })));
---
<ul class="games">
  {games.map((g, i) => (
    <li>
      {g.clip ? (
        <video class="clip" muted playsinline preload="none" poster={posters[i].src} width={g.width} height={g.height} aria-label={g.alt}>
          <source src={g.clip} type="video/mp4" />
        </video>
      ) : (
        <img class="clip still" src={posters[i].src} width={g.width} height={g.height} alt={g.alt} loading="lazy" decoding="async" />
      )}
      <h3>{g.name}</h3>
      <p>{g.text}</p>
      <p class="card-links">{g.links.map(([label, href]) => <a class="arrow" href={href}>{label}</a>)}</p>
    </li>
  ))}
</ul>
<p class="games-note">Clips recorded from the games. The test suite plays all three without a window.</p>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clips = [...document.querySelectorAll<HTMLVideoElement>('video.clip')];
  const replay = (clip: HTMLVideoElement) => {
    clip.currentTime = 0;
    clip.play().catch(() => {});
  };
  for (const clip of clips) {
    clip.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') replay(clip);
    });
    clip.addEventListener('click', () => (clip.paused ? replay(clip) : clip.pause()));
  }
  if (!still && 'IntersectionObserver' in window) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          replay(entry.target as HTMLVideoElement);
          seen.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );
    clips.forEach((clip) => seen.observe(clip));
  }
</script>
