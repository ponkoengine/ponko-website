---
// A picture with a caption. `src` is an imported image (optimised for you)
// or a path under public/. `wide` lets it run wider than the text.
//   import shot from './shot.png';
//   <Figure src={shot} alt="…" caption="…" wide />
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  wide?: boolean;
  /** Draw pixel art with hard edges. */
  pixelated?: boolean;
}
const { src, alt, caption, wide = false, pixelated = false } = Astro.props;
const style = pixelated ? 'image-rendering: pixelated' : undefined;
---
<figure class:list={['figure', { wide }]}>
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading="lazy" decoding="async" style={style} />
    : <Image src={src} alt={alt} widths={[640, 960, 1440]} sizes={wide ? '(max-width: 1100px) 100vw, 1040px' : '(max-width: 760px) 100vw, 720px'} style={style} />}
  {(caption || Astro.slots.has('default')) && <figcaption>{caption}<slot /></figcaption>}
</figure>
